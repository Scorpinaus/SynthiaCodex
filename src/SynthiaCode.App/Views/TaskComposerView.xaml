<UserControl x:Class="SynthiaCode.App.Views.TaskComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SynthiaCode.App.Controls"
             xmlns:views="clr-namespace:SynthiaCode.App.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="QueuedFollowUpPanel"
                Grid.Row="0"
                Style="{StaticResource Card}"
                Margin="0,10,0,0"
                Padding="10"
                Visibility="{Binding TaskWorkspace.Composer.HasQueuedFollowUps, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                AutomationProperties.Name="Queued follow-ups">
            <StackPanel>
                <TextBlock Text="{Binding TaskWorkspace.Composer.QueuedFollowUps.Count, StringFormat=Queued follow-ups ({0})}"
                           FontWeight="SemiBold"
                           Margin="2,0,2,6"/>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QueuedFollowUpList"
                                  ItemsSource="{Binding TaskWorkspace.Composer.QueuedFollowUps}"
                                  AutomationProperties.Name="Queued follow-up messages">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FieldBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="48"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     MinHeight="56"
                                                     MaxHeight="120"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     AutomationProperties.Name="Edit queued follow-up"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ReviewCommentSummary}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding HasReviewComments, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.Name="Queued inline review comments" />
                                        <TextBlock Text="{Binding LastError}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StateLabel}"
                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.BeginQueuedFollowUpEditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Edit queued follow-up"/>
                                                <Button Content="Save"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.SaveQueuedFollowUpEditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Save queued follow-up"/>
                                                <Button Content="Cancel edit"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.CancelQueuedFollowUpEditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Margin="4,0,0,0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Content="Up"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.MoveQueuedFollowUpUpCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Margin="4,0,0,0"
                                                        ToolTip="Move earlier"/>
                                                <Button Content="Down"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.MoveQueuedFollowUpDownCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Margin="4,0,0,0"
                                                        ToolTip="Move later"/>
                                                <Button Content="Send now"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.SendQueuedFollowUpCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Margin="4,0,0,0"/>
                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.TaskWorkspace.Composer.DeleteQueuedFollowUpCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        MinHeight="32"
                                                        Margin="4,0,0,0"/>
                                            </WrapPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border x:Name="ComposerDropTarget"
                Grid.Row="1"
                Style="{StaticResource PaneSurface}"
                Margin="0,12,0,0"
                Padding="12"
                AllowDrop="True"
                AutomationProperties.Name="Message composer">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:TaskGoalsView Grid.Row="0"/>

                <ItemsControl x:Name="SelectedSkillsList"
                              Grid.Row="1"
                              ItemsSource="{Binding TaskWorkspace.Composer.SkillSelector.SelectedSkills}"
                              Margin="0,0,0,8"
                              Visibility="{Binding TaskWorkspace.Composer.SkillSelector.HasSelectedSkills, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Selected skills">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ActionAccentSubtleBrush}"
                                    BorderBrush="{DynamicResource ActionAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,0,6,4"
                                    Padding="8,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Marker}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               ToolTip="{Binding Path}"/>
                                    <Button Content="×"
                                            Command="{Binding DataContext.TaskWorkspace.Composer.SkillSelector.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource CompactButton}"
                                            Margin="5,0,0,0"
                                            Padding="3,0"
                                            MinWidth="22"
                                            MinHeight="22"
                                            ToolTip="Remove skill"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Remove {0} skill}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid x:Name="PromptInputPanel" Grid.Row="3">
                    <TextBox x:Name="PromptBox"
                             Text="{Binding TaskWorkspace.Composer.Prompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="82"
                             MaxHeight="150"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"
                             PreviewKeyDown="OnComposerPreviewKeyDown"
                             KeyUp="OnComposerKeyUp"
                             Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             ToolTip="Describe a task. Press Ctrl+Enter to run."
                             AutomationProperties.Name="Task prompt"/>
                    <TextBox x:Name="GuidanceBox"
                             Text="{Binding TaskWorkspace.Composer.SteeringText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="82"
                             MaxHeight="150"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10"
                             PreviewKeyDown="OnComposerPreviewKeyDown"
                             KeyUp="OnComposerKeyUp"
                             Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="Guide the active task using this same composer."
                             AutomationProperties.Name="Active task guidance"/>
                </Grid>

                <StackPanel x:Name="AttachmentPreviewPanel"
                            Grid.Row="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding TaskWorkspace.Composer.HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AttachmentPreviewList"
                                      ItemsSource="{Binding TaskWorkspace.Composer.Attachments}"
                                      AutomationProperties.Name="Attachment previews">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="152" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0" Padding="5">
                                        <StackPanel>
                                            <Image Source="{Binding ManagedPath}" Height="72" Stretch="Uniform" ToolTip="{Binding DisplayName}" Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Border Height="72" Background="{DynamicResource PanelBrush}" CornerRadius="4" Visibility="{Binding IsImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding WorkspaceRelativePath}" Foreground="{DynamicResource MutedInkBrush}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="136"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" Margin="2,4,2,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LocationLabel}" Foreground="{DynamicResource MutedInkBrush}" FontSize="10" Margin="2,1,2,0"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                <Button Content="Open" Click="OnOpenAttachmentClick" Style="{StaticResource CompactButton}" Padding="5" ToolTip="Open file or reveal folder"/>
                                                <Button Content="←" Command="{Binding DataContext.TaskWorkspace.Composer.MoveAttachmentLeftCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" MinWidth="30" Padding="4" ToolTip="Move image left"/>
                                                <Button Content="→" Command="{Binding DataContext.TaskWorkspace.Composer.MoveAttachmentRightCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" MinWidth="30" Padding="4" Margin="3,0,0,0" ToolTip="Move image right"/>
                                                <Button Content="Remove" Command="{Binding DataContext.TaskWorkspace.Composer.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Padding="5" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding TaskWorkspace.Composer.AttachmentValidationMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel x:Name="ComposerOptionsPanel" VerticalAlignment="Center">
                        <views:TaskOptionsView/>

                        <ComboBox x:Name="ExecutionPolicySelector"
                                  ItemsSource="{Binding ExecutionPolicy.ModeOptions}"
                                  SelectedItem="{Binding ExecutionPolicy.SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanChangeExecutionPolicy}"
                                  MinHeight="32"
                                  MinWidth="132"
                                  MaxWidth="180"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Execution policy">
                            <ComboBox.ToolTip>
                                <StackPanel MaxWidth="320">
                                    <TextBlock Text="{Binding ExecutionPolicy.EffectiveSummary}"/>
                                    <TextBlock Text="{Binding ExecutionPolicy.ManagedSummary}"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ExecutionPolicy.ConfigurationWarning}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </ComboBox.ToolTip>
                        </ComboBox>

                        <ComboBox x:Name="CustomPermissionProfileSelector"
                                  ItemsSource="{Binding ExecutionPolicy.CustomProfileOptions}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ExecutionPolicy.SelectedCustomProfileId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanChangeExecutionPolicy}"
                                  Visibility="{Binding ExecutionPolicy.IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MinHeight="32"
                                  MinWidth="150"
                                  MaxWidth="220"
                                  Margin="8,0,0,0"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Choose the config.toml default or a named permission profile."
                                  AutomationProperties.Name="Custom permission profile">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SkillsButton"
                                Command="{Binding TaskWorkspace.Composer.SkillSelector.OpenCommand}"
                                Visibility="{Binding SupportsSkills, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource CompactButton}"
                                MinHeight="32"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                ToolTip="Select an enabled skill for explicit invocation. You can also type $ in the composer."
                                AutomationProperties.Name="Select skills">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="$" FontWeight="Bold"/>
                                <TextBlock Text=" Skills" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CodeReviewButton"
                                Content="Review"
                                Command="{Binding TaskWorkspace.Composer.StartCodeReviewCommand}"
                                Visibility="{Binding SupportsCodeReview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource CompactButton}"
                                MinHeight="32"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                ToolTip="Choose uncommitted changes, a base branch, a commit, or custom review instructions. You can also type /review."
                                AutomationProperties.Name="Start code review"/>
                        <Button x:Name="AttachButton"
                                Click="OnAttachClick"
                                Style="{StaticResource IconButton}"
                                MinHeight="32"
                                MinWidth="36"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                ToolTip="Attach images, files, or folders. Outside files and folders are saved as managed snapshots."
                                AutomationProperties.Name="Attach">
                            <Path Data="{StaticResource IconAttach}"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.4"
                                  Stretch="Uniform"/>
                            <Button.ContextMenu>
                                <ContextMenu Placement="Top">
                                    <MenuItem Header="Images..."
                                              Click="OnAttachImagesClick"
                                              AutomationProperties.Name="Attach images"/>
                                    <MenuItem Header="Files..."
                                              Click="OnAttachFilesClick"
                                              AutomationProperties.Name="Attach files"/>
                                    <MenuItem Header="Folder..."
                                              Click="OnAttachFolderClick"
                                              AutomationProperties.Name="Attach folder"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="DictationButton"
                                Command="{Binding TaskWorkspace.Composer.ToggleDictationCommand}"
                                MinHeight="32"
                                MinWidth="36"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                ToolTip="{Binding TaskWorkspace.Composer.DictationToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding TaskWorkspace.Composer.DictationAutomationName}"
                                AutomationProperties.HelpText="{Binding TaskWorkspace.Composer.DictationToolTip}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TaskWorkspace.Composer.IsDictating}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ActionAccentSubtleBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ActionAccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource IconMicrophone}"
                                  Width="18"
                                  Height="18"
                                  Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"/>
                        </Button>
                        <TextBlock Text="{Binding TaskWorkspace.Composer.DictationStatusText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   FontSize="12"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </WrapPanel>

                    <Popup x:Name="SkillsPopup"
                           PlacementTarget="{Binding ElementName=SkillsButton}"
                           Placement="Top"
                           VerticalOffset="-8"
                           IsOpen="{Binding TaskWorkspace.Composer.SkillSelector.IsOpen, Mode=TwoWay}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Opened="OnSkillsPopupOpened"
                           DataContext="{Binding DataContext, ElementName=SkillsButton}">
                        <Border Width="410"
                                MaxHeight="500"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="1"
                                PreviewKeyDown="OnSkillsPopupPreviewKeyDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Invoke a skill"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="SkillsSearchBox"
                                         Grid.Row="1"
                                         Text="{Binding TaskWorkspace.Composer.SkillSelector.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,8"
                                         Padding="8,5"
                                         AutomationProperties.Name="Search enabled skills"/>
                                <Grid Grid.Row="2">
                                    <ListBox x:Name="ComposerSkillsList"
                                             ItemsSource="{Binding TaskWorkspace.Composer.SkillSelector.FilteredSkills}"
                                             MaxHeight="340"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="Enabled skills">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.TaskWorkspace.Composer.SkillSelector.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Style="{StaticResource CompactButton}"
                                                        Padding="8"
                                                        Margin="0,0,0,4"
                                                        AutomationProperties.Name="{Binding DisplayName, StringFormat=Invoke {0}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Marker}"
                                                                           Foreground="{DynamicResource MutedInkBrush}"
                                                                           Margin="7,0,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}"
                                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,3,8,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ScopeLabel}"
                                                                   Foreground="{DynamicResource MutedInkBrush}"
                                                                   VerticalAlignment="Top"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding TaskWorkspace.Composer.SkillSelector.Message}"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="12"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding TaskWorkspace.Composer.SkillSelector.HasFilteredSkills, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Popup>



                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Border x:Name="ContextWindowIndicator"
                                Style="{StaticResource StatePill}"
                                MinHeight="32"
                                MinWidth="46"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding TaskWorkspace.Composer.ContextWindowToolTip}"
                                ToolTipService.InitialShowDelay="250"
                                ToolTipService.ShowDuration="60000"
                                AutomationProperties.Name="Context window usage"
                                AutomationProperties.HelpText="{Binding TaskWorkspace.Composer.ContextWindowToolTip}">
                            <TextBlock Text="{Binding TaskWorkspace.Composer.ContextWindowIndicator}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="{Binding TaskWorkspace.Composer.ComposerActionLabel}"
                                Command="{Binding TaskWorkspace.Composer.SubmitCommand}"
                                Style="{StaticResource RunTaskButton}"
                                MinWidth="104"
                                Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Content="{Binding TaskWorkspace.Composer.ComposerActionLabel}"
                                Command="{Binding TaskWorkspace.Composer.SteerCommand}"
                                Style="{StaticResource RunTaskButton}"
                                MinWidth="104"
                                Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button x:Name="AlternateFollowUpButton"
                                Content="{Binding TaskWorkspace.Composer.AlternateFollowUpActionLabel}"
                                Command="{Binding TaskWorkspace.Composer.AlternateFollowUpCommand}"
                                Style="{StaticResource CompactButton}"
                                MinHeight="32"
                                MinWidth="118"
                                Margin="8,0,0,0"
                                Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                ToolTip="Use the other follow-up behavior once (Ctrl+Shift+Enter)."
                                AutomationProperties.Name="Use alternate follow-up behavior"/>
                        <Button Content="Cancel"
                                Command="{Binding TaskWorkspace.Composer.CancelCommand}"
                                MinWidth="104"
                                Margin="8,0,0,0"
                                Visibility="{Binding TaskWorkspace.Composer.IsTurnRunning, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

