<UserControl x:Class="SynthiaCode.App.Views.SkillsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Codex skills and effective settings">
    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Codex skills" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Skills.ContextLabel}"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   FontSize="11"
                                   Margin="0,4,8,0"/>
                        <TextBlock Text="{Binding Skills.ContextPath}"
                                   Style="{StaticResource ValueText}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,8,0"/>
                    </StackPanel>
                    <Button x:Name="RefreshSkillsButton"
                            Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding Skills.RefreshCommand}"
                            Style="{StaticResource CompactButton}"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Refresh Codex skills"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="116"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SkillsSearchBox"
                             Text="{Binding Skills.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search Codex skills"
                             Padding="7,5"
                             Margin="0,0,6,0"/>
                    <ComboBox x:Name="SkillScopeFilter"
                              Grid.Column="1"
                              ItemsSource="{Binding Skills.ScopeFilters}"
                              SelectedItem="{Binding Skills.SelectedScopeFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Filter Codex skills by scope"/>
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource MutedInkBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite">
                    <Run Text="{Binding Skills.EnabledCount, Mode=OneWay}"/>
                    <Run Text=" enabled · "/>
                    <Run Text="{Binding Skills.DisabledCount, Mode=OneWay}"/>
                    <Run Text=" disabled · "/>
                    <Run Text="{Binding Skills.ErrorCount, Mode=OneWay}"/>
                    <Run Text=" discovery errors"/>
                </TextBlock>

                <ListBox x:Name="SkillsList"
                         ItemsSource="{Binding Skills.Skills}"
                         MaxHeight="380"
                         Margin="0,8,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Discovered Codex skills">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,8,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ScopeLabel}"
                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding StateLabel}"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Path}"
                                               Style="{StaticResource ValueText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding DependenciesSummary}"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="{Binding ToggleActionLabel}"
                                                Command="{Binding DataContext.Skills.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                Margin="0,0,6,0"
                                                AutomationProperties.Name="{Binding ToggleAutomationName}"/>
                                        <Button Content="Editor"
                                                Command="{Binding DataContext.Skills.OpenSkillCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Explorer"
                                                Command="{Binding DataContext.Skills.RevealSkillCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding Skills.Message}"
                           Foreground="{DynamicResource MutedInkBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Effective Codex settings" FontWeight="SemiBold"/>
                        <TextBlock Text="Resolved for the active workspace. Sensitive and unrecognized configuration is omitted."
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,8,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding EffectiveCodexSettings.RefreshCommand}"
                            Style="{StaticResource CompactButton}"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Refresh effective Codex settings"/>
                </Grid>

                <ItemsControl x:Name="EffectiveSettingsList"
                              ItemsSource="{Binding EffectiveCodexSettings.Items}"
                              Margin="0,9,0,0"
                              AutomationProperties.Name="Effective Codex settings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Value}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Origin}"
                                                   Foreground="{DynamicResource MutedInkBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EffectiveCodexSettings.Message}"
                           Foreground="{DynamicResource MutedInkBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
