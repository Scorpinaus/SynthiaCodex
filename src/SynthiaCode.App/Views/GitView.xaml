<UserControl x:Class="SynthiaCode.App.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Changed files inspector">
    <UserControl.Resources>
        <DataTemplate x:Key="ReviewFindingCardTemplate">
            <Border Margin="54,4,8,8"
                    Padding="10,8"
                    BorderThickness="1"
                    CornerRadius="6"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PriorityLabel}" Value="P0">
                                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PriorityLabel}" Value="P1">
                                <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PriorityLabel}" Value="P3">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="5,1"
                                Margin="0,0,7,0"
                                CornerRadius="4"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding PriorityLabel}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayTitle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Body}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LocationDisplay}"
                               Margin="0,6,0,0"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InlineReviewCommentCardTemplate">
            <Border Margin="54,4,8,8"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="5,1"
                                Margin="0,0,7,0"
                                CornerRadius="4"
                                Background="{DynamicResource FieldBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding SideLabel}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayLocation}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="{Binding Body}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBox Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,0"
                             MinHeight="58"
                             MaxHeight="140"
                             MaxLength="16384"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="Edit inline review comment" />
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="Edit"
                                Command="{Binding DataContext.Git.BeginEditCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CompactButton}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Edit inline review comment" />
                        <Button Content="Save"
                                Command="{Binding DataContext.Git.SaveEditedCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CompactButton}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Save inline review comment" />
                        <Button Content="Cancel"
                                Command="{Binding DataContext.Git.CancelEditCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CompactButton}"
                                Margin="5,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Cancel inline review comment edit" />
                        <Button Content="Remove"
                                Command="{Binding DataContext.Git.RemoveCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CompactButton}"
                                Margin="5,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Remove inline review comment" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource InspectorBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Git.Branch, TargetNullValue=Changes}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Git.StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Text="Repository"
                       Style="{StaticResource SectionLabel}"
                       Margin="0,10,0,4" />
            <ComboBox ItemsSource="{Binding Git.Repositories}"
                      SelectedItem="{Binding Git.SelectedRepository, Mode=TwoWay}"
                      DisplayMemberPath="DisplayLabel"
                      MinHeight="32"
                      AutomationProperties.Name="Repository"
                      ToolTip="Choose the attached Git repository to inspect" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Editor"
                        Command="{Binding Git.OpenEditorCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,5" />
                <Button Content="Explorer"
                        Command="{Binding Git.RevealExplorerCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,5" />
                <Button Content="Refresh"
                        Command="{Binding Git.RefreshCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,5" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Changed files" Style="{StaticResource SectionLabel}" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Git.ChangedFiles}"
                     SelectedItem="{Binding Git.SelectedFile}"
                     BorderThickness="1"
                     ItemContainerStyle="{StaticResource NavigationRow}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     AutomationProperties.Name="Changed files">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayPath}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayPath}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Grid.Row="2" Margin="0,7,0,0">
                <Button Content="Stage"
                        Command="{Binding Git.StageCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,0" />
                <Button Content="Unstage"
                        Command="{Binding Git.UnstageCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,0" />
                <Button Content="Discard"
                        Command="{Binding Git.DiscardCommand}"
                        Style="{StaticResource DangerButton}" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Git.DiffViewLabel}"
                       Style="{StaticResource SectionLabel}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Working"
                        Command="{Binding Git.ShowWorkingDiffCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0,0,5,0" />
                <Button Content="Staged"
                        Command="{Binding Git.ShowStagedDiffCommand}"
                        Style="{StaticResource CompactButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox ItemsSource="{Binding Git.SelectedDiffLines}"
                     Background="{DynamicResource SurfaceSunkenBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}"
                     BorderThickness="1"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Selected file diff">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel AutomationProperties.Name="{Binding AutomationName}">
                            <Border Padding="0,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Header">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Hunk">
                                                <Setter Property="Background" Value="{DynamicResource InfoSubtleBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Addition">
                                                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Removal">
                                                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OldLineDisplay}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextAlignment="Right"
                                               Padding="2,0,6,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding NewLineDisplay}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextAlignment="Right"
                                               Padding="2,0,6,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Prefix}"
                                               FontWeight="Bold"
                                               TextAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Content}"
                                               TextWrapping="NoWrap"
                                               Padding="2,0,10,0" />
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                Margin="4,0,6,0">
                                        <Button Content="Stage hunk"
                                                Command="{Binding DataContext.Git.StageHunkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                MinHeight="24"
                                                Padding="7,1"
                                                Visibility="{Binding CanStageHunk, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Stage hunk" />
                                        <Button Content="Unstage hunk"
                                                Command="{Binding DataContext.Git.UnstageHunkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                MinHeight="24"
                                                Padding="7,1"
                                                Visibility="{Binding CanUnstageHunk, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Unstage hunk" />
                                        <Button Content="Discard hunk"
                                                Command="{Binding DataContext.Git.DiscardHunkCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                MinHeight="24"
                                                Padding="7,1"
                                                Margin="5,0,0,0"
                                                Visibility="{Binding CanDiscardHunk, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Discard hunk" />
                                        <Button Content="Comment"
                                                Command="{Binding DataContext.Git.BeginAddCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                MinHeight="24"
                                                Padding="7,1"
                                                Visibility="{Binding CanAddComment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Add inline review comment" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Margin="54,4,8,8"
                                    Padding="10,8"
                                    Background="{DynamicResource FieldBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding IsCommentEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="New inline review comment editor">
                                <StackPanel>
                                    <TextBlock Text="Comment on this line"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CommentDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="64"
                                             MaxHeight="150"
                                             MaxLength="16384"
                                             Margin="0,6,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Inline review comment text" />
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="Save comment"
                                                Command="{Binding DataContext.Git.SaveCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                AutomationProperties.Name="Save inline review comment" />
                                        <Button Content="Cancel"
                                                Command="{Binding DataContext.Git.CancelAddCommentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CompactButton}"
                                                Margin="5,0,0,0"
                                                AutomationProperties.Name="Cancel new inline review comment" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ReviewFindings}"
                                          ItemTemplate="{StaticResource ReviewFindingCardTemplate}" />
                            <ItemsControl ItemsSource="{Binding UserComments}"
                                          ItemTemplate="{StaticResource InlineReviewCommentCardTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1"
                    MaxHeight="180"
                    Margin="0,8,0,0"
                    Padding="8"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Git.HasUnmatchedReviewFindings, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Review findings outside the visible diff">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Review findings not anchored in this diff"
                               FontWeight="SemiBold"
                               Margin="4,0,4,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Git.UnmatchedReviewFindings}"
                                      ItemTemplate="{StaticResource ReviewFindingCardTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="2"
                    MaxHeight="220"
                    Margin="0,8,0,0"
                    Padding="8"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding Git.HasReviewComments, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Pending inline review comments">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Git.PendingReviewCommentsLabel}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="4,0,4,4"
                               AutomationProperties.LiveSetting="Polite" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Git.ReviewComments}"
                                      ItemTemplate="{StaticResource InlineReviewCommentCardTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Commit staged changes" Style="{StaticResource SectionLabel}" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Git.CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="42"
                         MaxHeight="76"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Commit message" />
                <Button Grid.Column="1"
                        Content="Commit"
                        Command="{Binding Git.CommitCommand}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top" />
            </Grid>
        </Grid>

        <Border Grid.RowSpan="5"
                Panel.ZIndex="10"
                Style="{StaticResource EmptyStatePresenter}"
                Visibility="{Binding Git.IsRepository, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" MaxWidth="280">
                <TextBlock Text="No Git project attached"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Choose a Git project to review changes, or continue with a General task."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,8,0,16" />
                <Button Content="Choose a project"
                        Command="{Binding ProjectWorkspace.BrowseProjectCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
