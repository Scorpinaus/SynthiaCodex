<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SynthiaCode.Application\SynthiaCode.Application.csproj" />
    <ProjectReference Include="..\SynthiaCode.Core\SynthiaCode.Core.csproj" />
    <ProjectReference Include="..\SynthiaCode.Harnesses.Codex\SynthiaCode.Harnesses.Codex.csproj" />
    <ProjectReference Include="..\SynthiaCode.Infrastructure\SynthiaCode.Infrastructure.csproj" />
    <ProjectReference Include="..\SynthiaCode.Presentation\SynthiaCode.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Branding\SynthiaCode.ico" />
    <Resource Include="Assets\Branding\SynthiaCodeLogo.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Branding\SynthiaCode.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Product>SynthiaCode</Product>
    <AssemblyTitle>SynthiaCode</AssemblyTitle>
    <Authors>SynthiaCode contributors</Authors>
    <Company>SynthiaCode contributors</Company>
    <Copyright>Copyright © 2026 SynthiaCode contributors</Copyright>
    <Description>Independent Windows desktop client for OpenAI Codex.</Description>
    <RepositoryUrl>https://github.com/Scorpinaus/SynthiaCodex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
